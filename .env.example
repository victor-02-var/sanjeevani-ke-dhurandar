# Example environment variables for Vercel deployments
# Copy ONLY the keys (not values) from this file into Vercel's dashboard

# ========== BACKEND ==========
PORT=5000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
EMAIL_USER=
EMAIL_PASS=
TELEGRAM_BOT_TOKEN=
# OSRM_URL → leave blank on Vercel (uses public demo server fallback)
# REDIS_URL → leave blank on Vercel (rate limiter falls back gracefully)
CITIZEN_APP_URL=https://your-citizen-dashboard.vercel.app

# ========== CITIZEN DASHBOARD ==========
VITE_API_URL=https://your-backend.vercel.app/api

# ========== ADMIN DASHBOARD ==========
VITE_API_URL=https://your-backend.vercel.app/api

# ========== VEHICLE DASHBOARD ==========
VITE_API_BASE_URL=https://your-backend.vercel.app/api
